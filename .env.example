# --- Genel ---
# Yem alan adı: lokalde localhost, VPS'te gerçek domain (DNS A kaydı VPS'e)
BAIT_DOMAIN=localhost
ACME_EMAIL=you@example.com
DB_PASSWORD=change-me

# --- LLM --- (P0: stub, P3: llama)
LLM_BACKEND=stub
LLM_MAX_TOKENS=400
MODEL_FILE=sepetly-qwen3-1.7b-q4_k_m.gguf
LLM_THREADS=4

# --- Canary token'lar (canarytokens.org'dan üret) ---
CANARY_AWS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
CANARY_AWS_SECRET=replace-with-canary-secret
CANARY_URL=https://canarytokens.com/REPLACE/index.html
PAYMENT_KEY_PREFIX=sk_live_spt_
# Yem anahtarları ve geri-kullanım işaretleri bu tohumdan türetilir. Uzun, rastgele ve gizli tut:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# İşaretler tek tek de verilebilir: AGENT_KEY_MARK, GITHUB_KEY_MARK, LLM_KEY_MARK, OWU_KEY_MARK, WOPS_KEY_MARK, BTC_RPC_MARK
BAIT_SEED=

# --- Gözlem paneli ---
ADMIN_TOKEN=change-me-long-random
# VPS'te Tailscale IP'si (100.x.y.z); lokalde 127.0.0.1
ADMIN_BIND=127.0.0.1

# Analizden hariç tutulacak kendi IP'leriniz (virgülle; ev, ofis, droplet)
OWN_IPS=
